# ZYMORE - Environment Variables
// ============================================================
// FILE: .env.example
// PURPOSE: Environment variables template for ZYMORE
// USED BY: firebase-config.js, app-config.js, ad-service.js
// DEPENDENCY: NONE
// ============================================================
// 
// INSTRUCTIONS:
// 1. Copy this file to .env in the same directory
// 2. Replace ALL placeholder values with YOUR actual values
// 3. NEVER commit .env file to version control
// 4. Keep .env.example in version control for reference
//
// HOW TO GET VALUES:
// - Firebase: Go to Firebase Console → Project Settings → General → Your apps
// - AdMob: Go to AdMob Dashboard → Apps → App Settings
// - Google Drive: Go to Google Cloud Console → APIs & Services → Credentials
// ============================================================

// ============================================================
// FIREBASE CONFIGURATION
// ============================================================
// Get these from: Firebase Console → Project Settings → General → Your apps
// Click on the web app (</>) icon to get config

VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_AUTH_DOMAIN=zymore.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=zymore
VITE_FIREBASE_STORAGE_BUCKET=zymore.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

// ============================================================
// GOOGLE ADMOB CONFIGURATION
// ============================================================
// Get these from: AdMob Dashboard → Apps → Your App → Ad Units
// TEST IDs (for development):
// - Banner: ca-app-pub-3940256099942544/6300978111
// - Rewarded: ca-app-pub-3940256099942544/5224354917
// - Interstitial: ca-app-pub-3940256099942544/1033173712
// 
// PRODUCTION IDs (replace with your actual AdMob IDs):
// - Banner: ca-app-pub-YOUR_ID_HERE/XXXXXXXXXX
// - Rewarded: ca-app-pub-YOUR_ID_HERE/XXXXXXXXXX
// - Interstitial: ca-app-pub-YOUR_ID_HERE/XXXXXXXXXX

VITE_ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713
VITE_ADMOB_BANNER_ID=ca-app-pub-3940256099942544/6300978111
VITE_ADMOB_REWARDED_ID=ca-app-pub-3940256099942544/5224354917
VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-3940256099942544/1033173712
VITE_ADMOB_NATIVE_ID=ca-app-pub-3940256099942544/2247696110

// ============================================================
// GOOGLE DRIVE API CONFIGURATION
// ============================================================
// Get these from: Google Cloud Console → APIs & Services → Credentials
// Enable Google Drive API in the console first

VITE_GOOGLE_DRIVE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_GOOGLE_DRIVE_CLIENT_ID=123456789012-abc123def456.apps.googleusercontent.com
VITE_GOOGLE_DRIVE_CLIENT_SECRET=GOCSPX-XXXXXXXXXXXXXXXXXXXX
VITE_GOOGLE_DRIVE_REDIRECT_URI=https://zymore.web.app/oauth2callback
VITE_GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file

// ============================================================
// APP CONFIGURATION
// ============================================================

VITE_APP_NAME=ZYMORE
VITE_APP_DESCRIPTION=Free Digital Marketplace - Download High-Quality Assets
VITE_APP_URL=https://zymore.web.app
VITE_APP_ENV=production

// Environment: 'development', 'staging', 'production'
// Use 'development' for local testing (shows debug logs)
// Use 'production' for live app (minimizes logs)

VITE_APP_ENVIRONMENT=development
VITE_APP_VERSION=1.0.0

// ============================================================
// ANALYTICS CONFIGURATION
// ============================================================
// Get this from: Firebase Console → Analytics → Settings
// Or create a new Google Analytics 4 property

VITE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_ANALYTICS_ENABLED=true

// ============================================================
// API RATE LIMITS
// ============================================================
// Requests per minute per user
// Adjust based on your Firebase plan

VITE_RATE_LIMIT_REQUESTS=100
VITE_RATE_LIMIT_WINDOW=60000

// ============================================================
// FEATURE FLAGS
// ============================================================
// Toggle features on/off without redeploying
// Set to 'true' to enable, 'false' to disable

VITE_ENABLE_AI_CHAT=true
VITE_ENABLE_IMAGE_EDITOR=true
VITE_ENABLE_SOCIAL_LOGIN=true
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_SENTRY_LOGGING=true

// ============================================================
// SENTRY ERROR TRACKING (Optional)
// ============================================================
// Get these from: sentry.io → Project Settings → Client Keys (DSN)
// If not using Sentry, keep disabled

VITE_SENTRY_DSN=https://abc123def456@sentry.io/1234567
VITE_SENTRY_ENABLED=false
VITE_SENTRY_ENVIRONMENT=development

// ============================================================
// FILE UPLOAD CONFIGURATION
// ============================================================
// Max file sizes in bytes

VITE_MAX_IMAGE_SIZE=10485760  // 10MB in bytes
VITE_MAX_FILE_SIZE=20971520   // 20MB in bytes
VITE_MAX_TEMP_SIZE=52428800   // 50MB in bytes

VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/svg+xml
VITE_ALLOWED_FILE_TYPES=application/zip,application/pdf,application/rar,image/*,video/*

// ============================================================
// STORAGE PATHS
// ============================================================
// Firebase Storage paths (do not change unless necessary)

VITE_STORAGE_USER_PROFILE_PATH=users/{userId}/profile
VITE_STORAGE_PRODUCT_IMAGES_PATH=products/{productId}/images
VITE_STORAGE_PRODUCT_FILES_PATH=products/{productId}/files
VITE_STORAGE_TEMP_PATH=temp/{userId}
VITE_STORAGE_CACHE_PATH=cache

// ============================================================
// DATABASE COLLECTIONS
// ============================================================
// Firestore collection names (do not change unless necessary)

VITE_COLLECTION_USERS=users
VITE_COLLECTION_PRODUCTS=products
VITE_COLLECTION_REVIEWS=reviews
VITE_COLLECTION_HISTORY=history
VITE_COLLECTION_LIKES=likes
VITE_COLLECTION_CATEGORIES=categories
VITE_COLLECTION_NOTIFICATIONS=notifications
VITE_COLLECTION_REPORTS=reports
VITE_COLLECTION_DOWNLOADS=downloads

// ============================================================
// SEO & META TAGS
// ============================================================
// Default meta tags - will be overridden on product pages

VITE_DEFAULT_TITLE=ZYMORE - Free Digital Marketplace
VITE_DEFAULT_DESCRIPTION=Download high-quality digital assets, wallpapers, icons, and more for free
VITE_DEFAULT_KEYWORDS=digital marketplace, free downloads, wallpapers, icons, assets
VITE_DEFAULT_IMAGE=https://zymore.web.app/assets/images/og-image.jpg

// ============================================================
// SOCIAL MEDIA LINKS
// ============================================================
// Your social media profiles

VITE_SOCIAL_INSTAGRAM=https://instagram.com/zymoreapp
VITE_SOCIAL_TWITTER=https://twitter.com/zymoreapp
VITE_SOCIAL_YOUTUBE=https://youtube.com/@zymoreapp
VITE_SOCIAL_FACEBOOK=https://facebook.com/zymoreapp
VITE_SOCIAL_DISCORD=https://discord.gg/zymore

// ============================================================
// CACHE SETTINGS
// ============================================================
// Cache duration in seconds

VITE_CACHE_STATIC_DURATION=86400   // 24 hours
VITE_CACHE_API_DURATION=3600       // 1 hour
VITE_CACHE_IMAGE_DURATION=604800   // 7 days
VITE_CACHE_PRODUCT_DURATION=3600   // 1 hour

// ============================================================
// PWA CONFIGURATION
// ============================================================

VITE_PWA_ENABLED=true
VITE_PWA_NAME=ZYMORE
VITE_PWA_SHORT_NAME=ZYMORE
VITE_PWA_START_URL=/
VITE_PWA_THEME_COLOR=#FF6B35
VITE_PWA_BACKGROUND_COLOR=#FFFFFF
VITE_PWA_DISPLAY=standalone
VITE_PWA_ORIENTATION=portrait

// ============================================================
// GOOGLE ANALYTICS / TAG MANAGER
// ============================================================
// If using GTM instead of Firebase Analytics

VITE_GTM_ID=GTM-XXXXXXX
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

// ============================================================
// STRIPE / PAYMENT (Future)
// ============================================================
// For future premium features

VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key_here
VITE_STRIPE_SECRET_KEY=sk_live_your_secret_key_here
VITE_STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

// ============================================================
// RECAPTCHA (For forms)
// ============================================================
// Get from: Google reCAPTCHA Console

VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
VITE_RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

// ============================================================
// EMAIL SERVICE (For contact/notifications)
// ============================================================
// Using EmailJS or similar service

VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_USER_ID=user_xxxxxxx

// ============================================================
// CLOUDINARY (For image optimization)
// ============================================================
// Optional: Use Cloudinary for advanced image optimization

VITE_CLOUDINARY_CLOUD_NAME=zymore
VITE_CLOUDINARY_API_KEY=123456789012345
VITE_CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz
VITE_CLOUDINARY_UPLOAD_PRESET=zymore_uploads

// ============================================================
// ALGOLIA (For search - Future)
// ============================================================

VITE_ALGOLIA_APP_ID=XXXXXXXXXX
VITE_ALGOLIA_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_ALGOLIA_INDEX_NAME=products

// ============================================================
// END OF ENVIRONMENT VARIABLES
// ============================================================
// 
// IMPORTANT:
// 1. Never commit .env file with real values
// 2. Always use .env.example as template
// 3. Update this file whenever new variables are added
// 4. Inform team about new variables
// 
// ============================================================